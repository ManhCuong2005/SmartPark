**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local three-app launcher logs
.smartpark/

# Local environment and IDE migration state
.env
.env.*
!.env.example
/.github/modernize/

# Transient Figma MCP context and capability URLs (assets are already local)
/docs/figma/*.txt
/docs/figma/assets.json
/docs/figma/screenshots.json
/admin-web/docs/figma/*.txt
/admin-web/docs/figma/assets.json
/admin-web/docs/figma/screenshots.json

# One-time import helpers depend on the local transient MCP manifests above
/tools/download_figma.cjs
/tools/download_references.cjs
/admin-web/tools/download-assets.mjs
/admin-web/tools/asset-metadata.mjs
